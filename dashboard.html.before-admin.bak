<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0c0d0f">
  <title>VANTIX MANAGER — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root{color-scheme:dark;--bg:#0b0c0f;--panel:#121416;--panel2:#17191b;--line:#26282a;--gold:#d9b35b;--gold2:#f0d58a;--text:#eee9dc;--muted:#8d8a81;--green:#8ec5a0;--red:#dd8d7f;--blue:#a2b9d5}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 65% -25%,#6c531722 0,transparent 52%),var(--bg);color:var(--text);font-family:Prompt,sans-serif;font-weight:300}.app{min-height:100vh;display:grid;grid-template-columns:246px 1fr}.sidebar{border-right:1px solid var(--line);background:#0d0f10;padding:27px 18px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:12px;padding:0 10px 30px;border-bottom:1px solid var(--line)}.brand img{width:43px;height:43px;border-radius:50%;object-fit:cover;border:1px solid #caa75188;box-shadow:0 0 18px #caa75122}.brand-name{font:600 14px Cinzel,serif;letter-spacing:1.4px;color:#e9d69e}.brand-caption{font:9px Prompt,sans-serif;letter-spacing:2px;color:#8d8777;margin-top:3px}.nav-label{font-size:9px;text-transform:uppercase;letter-spacing:1.7px;color:#706f69;margin:26px 10px 10px}.nav-link{height:42px;padding:0 12px;display:flex;align-items:center;gap:12px;text-decoration:none;color:#aaa79e;border:1px solid transparent;border-radius:9px;font-size:12px;transition:.2s}.nav-link i{width:16px;text-align:center;color:#91866d}.nav-link.active{background:linear-gradient(100deg,#be98441b,#be984407);border-color:#be984428;color:#f1dfb0}.nav-link.active i{color:var(--gold)}.nav-link:hover{background:#ffffff08;color:#eee}.side-bottom{margin-top:auto}.secure-box{border:1px solid #292a27;border-radius:10px;padding:13px;margin:15px 2px;background:linear-gradient(145deg,#171813,#111211)}.secure-title{font-size:10px;color:#d8c996;display:flex;align-items:center;gap:8px}.secure-title i{color:#b69a52}.secure-text{font-size:9px;line-height:1.6;color:#77776f;margin:7px 0 0}.user-mini{display:flex;align-items:center;gap:10px;border-top:1px solid var(--line);padding:17px 5px 0}.avatar{height:32px;width:32px;border-radius:50%;display:grid;place-items:center;background:#302a1a;border:1px solid #9a7e3b66;color:#e5ce8a;font:500 12px Cinzel,serif}.user-mini strong{font-size:11px;font-weight:500;display:block;max-width:140px;overflow:hidden;text-overflow:ellipsis}.user-mini small{font-size:9px;color:var(--muted)}.main{min-width:0}.topbar{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,4vw,54px)}.crumb{font-size:11px;color:var(--muted)}.crumb b{font-weight:400;color:#d9d4c8}.top-actions{display:flex;align-items:center;gap:13px}.secure-pill{font-size:9px;color:#b0ad9d;border:1px solid #35352f;background:#151613;border-radius:30px;padding:7px 10px;display:flex;align-items:center;gap:7px}.secure-pill i{font-size:9px;color:var(--green)}.logout{border:1px solid #39332a;background:#171512;color:#c9b783;border-radius:7px;padding:8px 11px;font:10px Prompt,sans-serif;transition:.2s}.logout:hover{border-color:#947637;color:#f0d58a}.content{max-width:1250px;margin:auto;padding:38px clamp(20px,4vw,54px) 55px}.welcome{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:25px}.kicker{font:10px Cinzel,serif;letter-spacing:2.1px;color:#b89b59;text-transform:uppercase}.welcome h1{font-size:25px;letter-spacing:-.5px;font-weight:400;margin:7px 0 4px}.welcome p{font-size:11px;color:var(--muted);margin:0}.today{font-size:10px;color:#817e75;display:flex;gap:8px;align-items:center}.today i{color:#b79a56}.hero{position:relative;overflow:hidden;border:1px solid #61502b;background:linear-gradient(112deg,#211d13 0%,#171713 43%,#131517 100%);border-radius:13px;padding:25px 28px;display:flex;justify-content:space-between;align-items:center;margin-bottom:17px}.hero:after{content:"";position:absolute;width:310px;height:310px;border-radius:50%;right:11%;top:-230px;background:#d3a744;filter:blur(100px);opacity:.11;pointer-events:none}.hero-copy{position:relative;z-index:1}.hero-tag{font-size:9px;letter-spacing:1.7px;text-transform:uppercase;color:#c8aa61}.hero h2{font-size:20px;font-weight:400;margin:7px 0 5px}.hero p{font-size:10px;color:#aaa494;margin:0}.hero-mark{position:relative;z-index:1;color:#d0ad58;font:500 27px Cinzel,serif;letter-spacing:4px;opacity:.8;padding-right:12px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:18px}.card{border:1px solid var(--line);background:linear-gradient(145deg,#151719,#111314);border-radius:10px;padding:17px 17px 15px;min-height:119px;position:relative;overflow:hidden}.card::after{content:"";position:absolute;right:-24px;top:-32px;width:92px;height:92px;border-radius:50%;background:var(--aura,#c9a54a);filter:blur(45px);opacity:.12}.card-top{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#aaa69b}.card-icon{width:27px;height:27px;border-radius:7px;background:#25231b;color:var(--icon,#d5b25c);display:grid;place-items:center;font-size:11px}.card-value{font-size:20px;font-weight:500;letter-spacing:-.3px;margin-top:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-sub{font-size:9px;color:#7e7c74;margin-top:3px}.lower{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.panel{border:1px solid var(--line);background:#121416;border-radius:10px;overflow:hidden}.panel-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.panel-head h3{font-size:11px;font-weight:500;margin:0;display:flex;align-items:center;gap:9px}.panel-head h3 i{color:#b79954;font-size:10px}.panel-head span{font-size:9px;color:#77766f}.details{padding:3px 17px}.detail-row{padding:13px 0;border-bottom:1px solid #222426;display:flex;align-items:center;justify-content:space-between;gap:15px}.detail-row:last-child{border:0}.detail-label{font-size:10px;color:#89877f;display:flex;align-items:center;gap:9px}.detail-label i{width:13px;color:#8d805e;font-size:10px}.detail-value{font-size:10px;color:#e2ded3;text-align:right;word-break:break-word}.status{display:inline-flex;align-items:center;gap:6px;border:1px solid #34513c;background:#18241a;color:var(--green);border-radius:30px;padding:4px 8px;font-size:9px}.status::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor}.status.warn{border-color:#624444;background:#291a19;color:#e0a193}.status.neutral{border-color:#494436;background:#211f18;color:#d7be78}.progress-wrap{padding:17px}.progress-title{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#c5c0b4}.progress-track{height:5px;background:#292a27;border-radius:9px;margin:11px 0 8px;overflow:hidden}.progress-bar{height:100%;width:0;background:linear-gradient(90deg,#98742c,#efd27a);border-radius:9px;transition:width .7s}.progress-caption{font-size:9px;color:#77776e;line-height:1.7}.notice{padding:12px 13px;background:#191915;border:1px solid #333027;border-radius:8px;color:#999487;font-size:9px;line-height:1.7;margin-top:15px}.notice i{color:#c6a956;margin-right:5px}.loading{color:#aaa}.error-card{border:1px solid #563532;background:#1b1413;color:#dba69b;padding:13px 15px;border-radius:8px;font-size:11px;display:none;margin-bottom:15px}.footer{margin-top:23px;text-align:center;font-size:9px;color:#65645e;letter-spacing:.3px}.mobile-brand{display:none}
    @media(max-width:1050px){.app{grid-template-columns:205px 1fr}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.app{display:block}.sidebar{display:none}.topbar{height:61px;padding:0 16px}.mobile-brand{display:flex;align-items:center;gap:8px;font:600 11px Cinzel,serif;letter-spacing:1px;color:#e9d69e}.mobile-brand img{height:27px;width:27px;border-radius:50%}.secure-pill{display:none}.content{padding:26px 15px 35px}.welcome{align-items:flex-start;flex-direction:column;gap:10px}.welcome h1{font-size:22px}.hero{padding:20px 17px}.hero h2{font-size:16px}.hero-mark{font-size:19px;letter-spacing:2px;padding:0}.cards{gap:9px}.card{padding:13px;min-height:108px}.card-value{font-size:17px}.lower{grid-template-columns:1fr;gap:11px}.today{font-size:9px}.logout{padding:7px 9px}}
  </style>
  <style>.avatar{display:block;object-fit:cover;padding:2px}</style>
  <style>
    .confirm-overlay{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(5,6,7,.78);backdrop-filter:blur(5px)}
    .confirm-overlay.open{display:flex;animation:confirmFade .18s ease-out}
    .confirm-dialog{width:min(390px,100%);padding:27px 25px 22px;border:1px solid #725c2d;border-radius:15px;background:linear-gradient(145deg,#1c1b17,#121416 72%);box-shadow:0 24px 80px #000a;text-align:center;animation:confirmPop .2s ease-out}
    .confirm-icon{height:48px;width:48px;margin:0 auto 15px;border-radius:50%;display:grid;place-items:center;border:1px solid #9f7d35;background:#2a2416;color:#e4c36e;font-size:18px;box-shadow:0 0 24px #bd994622}
    .confirm-dialog h2{font-size:16px;font-weight:500;margin:0;color:#f0e7d1}.confirm-dialog p{font-size:11px;line-height:1.7;color:#969187;margin:8px 0 21px}
    .confirm-actions{display:flex;justify-content:center;gap:9px}.confirm-actions button{min-width:112px;border-radius:8px;padding:9px 14px;font:11px Prompt,sans-serif;transition:.18s}
    .confirm-cancel{border:1px solid #383833;background:#1a1b1a;color:#b9b5aa}.confirm-cancel:hover{border-color:#666259;color:#f4efe4}
    .confirm-yes{border:1px solid #b38f40;background:linear-gradient(135deg,#f0d47e,#bd9239);color:#19150c;font-weight:600}.confirm-yes:hover{filter:brightness(1.08);transform:translateY(-1px)}
    @keyframes confirmFade{from{opacity:0}to{opacity:1}}@keyframes confirmPop{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand"><img src="/logo/vantix-logo.png" alt="VANTIX"><div><div class="brand-name">VANTIX MANAGER</div><div class="brand-caption">MEMBER PORTAL</div></div></div>
      <div class="nav-label">เมนูหลัก</div>
      <a class="nav-link active" href="/dashboard.html"><i class="fa-solid fa-grip"></i> ภาพรวม</a>
      <a class="nav-link" href="/games-dashboard.html"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
      <div class="side-bottom">
        <div class="secure-box"><div class="secure-title"><i class="fa-solid fa-shield-halved"></i> พื้นที่สมาชิก</div><p class="secure-text">ข้อมูลบัญชีของคุณแสดงให้เห็นเฉพาะหลังเข้าสู่ระบบเท่านั้น</p></div>
        <div class="user-mini"><img class="avatar" id="sideAvatar" src="/logo/vantix-logo.png" alt="VANTIX logo"><div><strong id="sideUsername">กำลังโหลด...</strong><small>สมาชิก VANTIX</small></div></div>
      </div>
    </aside>
    <main class="main">
      <header class="topbar"><div class="mobile-brand"><img src="/logo/vantix-logo.png" alt=""> VANTIX MANAGER</div><div class="crumb">สมาชิก <span style="color:#555">/</span> <b>ภาพรวม</b></div><div class="top-actions"><div class="secure-pill"><i class="fa-solid fa-circle-check"></i> บัญชีได้รับการยืนยัน</div><button class="logout" id="logout"><i class="fa-solid fa-arrow-right-from-bracket"></i>&nbsp; ออกจากระบบ</button></div></header>
      <div class="content">
        <div class="welcome"><div><div class="kicker">Member dashboard</div><h1>ยินดีต้อนรับ, <span id="welcomeName" class="loading">กำลังโหลด...</span></h1><p>จัดการข้อมูลสมาชิกและตรวจสอบสถานะคีย์ของคุณ</p></div><div class="today"><i class="fa-regular fa-calendar"></i><span id="today"></span></div></div>
        <div class="error-card" id="errorBox"></div>
        <section class="hero"><div class="hero-copy"><div class="hero-tag"><i class="fa-solid fa-sparkles"></i> VANTIX MANAGER</div><h2>ทุกอย่างพร้อมใช้งาน</h2><p>ตรวจสอบสิทธิ์และระยะเวลาการใช้งานได้จากหน้าเดียว</p></div><div class="hero-mark">VANTIX</div></section>
        <section class="cards">
          <article class="card" style="--icon:#e2c674;--aura:#c6a54f"><div class="card-top">สถานะคีย์ <span class="card-icon"><i class="fa-solid fa-shield-halved"></i></span></div><div class="card-value"><span class="status" id="statusBadge">กำลังโหลด</span></div><div class="card-sub">สถานะสิทธิ์การใช้งานปัจจุบัน</div></article>
          <article class="card" style="--icon:#a9c8ad;--aura:#76b283"><div class="card-top">เวลาใช้งานคงเหลือ <span class="card-icon"><i class="fa-regular fa-clock"></i></span></div><div class="card-value" id="remaining">—</div><div class="card-sub">นับถอยหลังตามเวลาหมดอายุ</div></article>
          <article class="card" style="--icon:#b1bfd5;--aura:#7792bd"><div class="card-top">วันหมดอายุ <span class="card-icon"><i class="fa-regular fa-calendar-check"></i></span></div><div class="card-value" id="expires">—</div><div class="card-sub" id="expiresSub">วันและเวลาตามระบบเซิร์ฟเวอร์</div></article>
          <article class="card" style="--icon:#d5ad85;--aura:#ad7847"><div class="card-top">บัญชีสมาชิก <span class="card-icon"><i class="fa-regular fa-user"></i></span></div><div class="card-value" id="accountName">—</div><div class="card-sub" id="accountEmail">บัญชี VANTIX MANAGER</div></article>
        </section>
        <section class="lower">
          <article class="panel" id="license"><div class="panel-head"><h3><i class="fa-solid fa-key"></i> รายละเอียดคีย์เข้าใช้งาน</h3><span>LICENSE DETAILS</span></div><div class="details"><div class="detail-row"><span class="detail-label"><i class="fa-regular fa-user"></i> ชื่อผู้ใช้</span><span class="detail-value" id="detailUsername">—</span></div><div class="detail-row"><span class="detail-label"><i class="fa-solid fa-key"></i> Access key</span><span class="detail-value" id="detailKey">—</span></div><div class="detail-row"><span class="detail-label"><i class="fa-regular fa-hourglass-half"></i> ระยะเวลาคีย์เดิม</span><span class="detail-value" id="detailDuration">—</span></div><div class="detail-row"><span class="detail-label"><i class="fa-regular fa-calendar"></i> หมดอายุเมื่อ</span><span class="detail-value" id="detailExpiry">—</span></div></div></article>
          <article class="panel"><div class="panel-head"><h3><i class="fa-solid fa-chart-line"></i> อายุการใช้งาน</h3><span>LICENSE LIFETIME</span></div><div class="progress-wrap"><div class="progress-title"><span>เวลาที่เหลือ</span><strong id="progressPct">—</strong></div><div class="progress-track"><div class="progress-bar" id="progressBar"></div></div><div class="progress-caption" id="progressCaption">กำลังโหลดข้อมูลสิทธิ์...</div><div class="notice"><i class="fa-solid fa-circle-info"></i> หากข้อมูลคีย์ไม่ถูกต้องหรือมีปัญหาในการเข้าใช้งาน โปรดติดต่อผู้ดูแลระบบ</div></div></article>
        </section>
        <div class="footer">VANTIX MANAGER &nbsp;·&nbsp; MEMBER PORTAL</div>
      </div>
    </main>
  </div>
  <div class="confirm-overlay" id="logoutDialog" aria-hidden="true">
    <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="logoutTitle" aria-describedby="logoutDescription">
      <div class="confirm-icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></div>
      <h2 id="logoutTitle">ยืนยันการออกจากระบบ</h2>
      <p id="logoutDescription">คุณต้องการออกจากระบบใช่ไหม?</p>
      <div class="confirm-actions"><button class="confirm-cancel" id="cancelLogout" type="button">ยกเลิก</button><button class="confirm-yes" id="confirmLogout" type="button">ออกจากระบบ</button></div>
    </section>
  </div>
  <script>
    const $=id=>document.getElementById(id);
    const fmtDate=value=>value?new Intl.DateTimeFormat('th-TH',{dateStyle:'medium',timeStyle:'short'}).format(new Date(value.replace(' ','T'))):'ยังไม่เริ่มใช้งาน';
    const span=(ms)=>{if(ms<=0)return 'หมดอายุแล้ว';let total=Math.floor(ms/1000),d=Math.floor(total/86400);total%=86400;let h=Math.floor(total/3600);total%=3600;let m=Math.floor(total/60);if(d>0)return `${d} วัน ${h} ชม.`;if(h>0)return `${h} ชม. ${m} นาที`;return `${m} นาที`};
    let expiresAt=null,totalMs=0;
    function tick(){if(!expiresAt)return;const left=expiresAt-Date.now();$('remaining').textContent=span(left);const pct=totalMs>0?Math.max(0,Math.min(100,left/totalMs*100)):0;$('progressBar').style.width=`${pct}%`;$('progressPct').textContent=left<=0?'หมดอายุ':`${Math.round(pct)}%`;$('progressCaption').textContent=left<=0?'คีย์นี้หมดอายุแล้ว กรุณาติดต่อผู้ดูแลเพื่อขอต่ออายุ':'ระบบอัปเดตเวลาคงเหลือให้อัตโนมัติ'}
    async function loadAccount(){try{const res=await fetch('/api/me',{cache:'no-store'});const data=await res.json();if(res.status===401){location.replace('/');return}if(!res.ok||!data.success)throw new Error(data.message||'โหลดข้อมูลบัญชีไม่สำเร็จ');const username=data.username||'สมาชิก';$('welcomeName').textContent=username;$('welcomeName').classList.remove('loading');$('sideUsername').textContent=username;$('accountName').textContent=username;$('accountEmail').textContent=data.email||'บัญชี VANTIX MANAGER';$('detailUsername').textContent=username;$('detailKey').textContent=data.license_key||'—';const d=data.duration||{};$('detailDuration').textContent=[d.days?`${d.days} วัน`:null,d.hours?`${d.hours} ชม.`:null,d.minutes?`${d.minutes} นาที`:null].filter(Boolean).join(' ')||'ไม่ระบุระยะเวลา';$('detailExpiry').textContent=fmtDate(data.expires_at);$('expires').textContent=data.expires_at?new Intl.DateTimeFormat('th-TH',{day:'numeric',month:'short',year:'2-digit'}).format(new Date(data.expires_at.replace(' ','T'))):'ไม่จำกัด';$('expiresSub').textContent=data.expires_at?fmtDate(data.expires_at):'ยังไม่มีวันหมดอายุ';const status=(data.status||'active').toLowerCase(),badge=$('statusBadge');badge.textContent=status==='active'?'ใช้งานได้':status==='expired'?'หมดอายุ':status==='disabled'?'ปิดใช้งาน':status==='banned'?'ระงับบัญชี':status;badge.className='status'+(status==='expired'||status==='banned'?' warn':status==='disabled'?' neutral':'');if(data.expires_at){expiresAt=new Date(data.expires_at.replace(' ','T')).getTime();totalMs=((d.days||0)*86400+(d.hours||0)*3600+(d.minutes||0)*60)*1000;if(totalMs<=0)totalMs=Math.max(1000,expiresAt-Date.now())}else{$('remaining').textContent='ไม่จำกัด';$('progressPct').textContent='∞';$('progressBar').style.width='100%';$('progressCaption').textContent='บัญชีนี้ยังไม่มีวันหมดอายุ'}tick()}catch(error){$('errorBox').style.display='block';$('errorBox').textContent=error.message;$('welcomeName').textContent='สมาชิก';$('welcomeName').classList.remove('loading')}}
    $('today').textContent=new Intl.DateTimeFormat('th-TH',{dateStyle:'full'}).format(new Date());
    const logoutDialog=$('logoutDialog');
    const closeLogoutDialog=()=>{logoutDialog.classList.remove('open');logoutDialog.setAttribute('aria-hidden','true')};
    $('logout').addEventListener('click',()=>{logoutDialog.classList.add('open');logoutDialog.setAttribute('aria-hidden','false');$('cancelLogout').focus()});
    $('cancelLogout').addEventListener('click',closeLogoutDialog);
    logoutDialog.addEventListener('click',event=>{if(event.target===logoutDialog)closeLogoutDialog()});
    document.addEventListener('keydown',event=>{if(event.key==='Escape'&&logoutDialog.classList.contains('open'))closeLogoutDialog()});
    $('confirmLogout').addEventListener('click',async()=>{const button=$('confirmLogout');button.disabled=true;button.textContent='กำลังออกจากระบบ...';try{await fetch('/api/logout',{method:'POST'})}finally{sessionStorage.removeItem('vantix_user');location.replace('/')}});
    loadAccount();setInterval(tick,1000);
  </script>
</body>
</html>
